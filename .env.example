# Interior Design System - Environment Variables
# Copy this file to .env and fill in the values

# ====================
# REQUIRED
# ====================

# Google Gemini API Key
# Get one at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ====================
# OPTIONAL (defaults shown)
# ====================

# Blender executable path
BLENDER_PATH=/usr/local/bin/blender

# Directory paths
BLENDER_SCRIPTS_DIR=./blender/scripts
OUTPUT_DIR=./output
SCENES_DIR=./scenes
UPLOADS_DIR=./uploads
ASSETS_DIR=./blender/assets

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Mock services (for development without Blender/Gemini)
USE_MOCK_BLENDER=false
USE_MOCK_GEMINI=false
