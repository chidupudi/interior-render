# Interior Design System - Environment Configuration

# Google Gemini API Key (required for production)
GEMINI_API_KEY=your_gemini_api_key_here

# Blender Configuration
BLENDER_PATH=/usr/bin/blender
BLENDER_SCRIPTS_DIR=/app/blender/scripts
BLENDER_TIMEOUT=120

# Directory Paths
OUTPUT_DIR=/app/output
SCENES_DIR=/app/scenes
UPLOADS_DIR=/app/uploads
ASSETS_DIR=/app/blender/assets

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Mock Services (for development without Blender/Gemini)
USE_MOCK_BLENDER=false
USE_MOCK_GEMINI=false
